{
    "name": "charlesstolive/filament-map",
    "description": "A Filament plugin to integrate interactive maps",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filament",
        "map",
        "leaflet"
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "filament/filament": "^5.0",
        "filament/spatie-laravel-media-library-plugin": "^5.0",
        "guava/filament-knowledge-base": "^3.0",
        "livewire/livewire": "^3.0|^4.0",
        "spatie/laravel-package-tools": "^1.16",
        "spatie/laravel-medialibrary": "^11.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "CharlesStOlive\\FilamentMap\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CharlesStOlive\\FilamentMap\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CharlesStOlive\\FilamentMap\\FilamentMapServiceProvider"
            ],
            "aliases": {
                "FilamentMap": "CharlesStOlive\\FilamentMap\\Facades\\FilamentMap"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}